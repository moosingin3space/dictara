<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.dictara.Dictara</id>
  <name>Dictara</name>
  <summary>Speech-to-text dictation</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      Dictara turns speech into text anywhere you type: hold a shortcut,
      dictate, release — the transcription is pasted into the focused
      application. Supports local transcription models (Whisper, Parakeet)
      as well as OpenAI and Azure OpenAI.
    </p>
  </description>
  <launchable type="desktop-id">app.dictara.Dictara.desktop</launchable>
  <url type="homepage">https://dictara.app</url>
  <developer id="app.dictara">
    <name>Dictara</name>
  </developer>
  <content_rating type="oars-1.1" />
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
</component>
